# サーバー
PORT=8787
HOST=127.0.0.1

# userscript との共有トークン (X-Agent-Runner-Token ヘッダ)
# これは認証ではなく事故防止。本質的な安全境界は 127.0.0.1 bind。
AGENT_RUNNER_TOKEN=change-me-to-a-random-string

# GitHub Personal Access Token (repo スコープ)
GITHUB_TOKEN=

# PR 作成ジョブでコメント/コミットを許可する GitHub ユーザー名 (カンマ区切り)
# プロンプトインジェクション対策。Issue にコメントできる全員を信頼しない。
ALLOWED_AUTHORS=shono1103

# git commit の author
BOT_NAME=agent-runner-bot
BOT_EMAIL=agent-runner-bot@users.noreply.github.com

# true の間は git push / PR 作成を行わずブランチと差分だけ残す
AGENT_RUNNER_DRY_RUN=true

# claude cli
CLAUDE_MODEL=sonnet
CONVERT_MAX_BUDGET_USD=0.5
PR_MAX_BUDGET_USD=5
INVESTIGATE_MAX_BUDGET_USD=1
CONVERT_TIMEOUT_MS=300000
PR_TIMEOUT_MS=1800000
INVESTIGATE_TIMEOUT_MS=600000
