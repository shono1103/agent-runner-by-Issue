# テスト実行用の設定。実際の秘密情報は含めない (config.ts の起動時検証を満たすためのダミー値)。
PORT=8787
HOST=127.0.0.1

AGENT_RUNNER_TOKEN=test-token-not-real
GITHUB_TOKEN=test-token-not-real
ALLOWED_AUTHORS=test-user

BOT_NAME=agent-runner-test-bot
BOT_EMAIL=agent-runner-test-bot@users.noreply.github.com

AGENT_RUNNER_DRY_RUN=true

CLAUDE_MODEL=sonnet
CONVERT_MAX_BUDGET_USD=0.5
PR_MAX_BUDGET_USD=5
CLARIFY_MAX_BUDGET_USD=0.3
CONVERT_TIMEOUT_MS=300000
PR_TIMEOUT_MS=1800000
CLARIFY_TIMEOUT_MS=180000
