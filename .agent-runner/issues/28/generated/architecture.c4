specification {
  element system
  element component
  element actor
}

model {
  maintainer = actor 'Maintainer' {
    description 'agent-runner-by-Issue の運用者'
  }

  webhook = system 'webhook' {
    routes = component 'jobs route (POST /resolve-conflicts)'
    job = component 'resolveConflicts.ts'
    prompt = component 'prompts/resolveConflicts.ts'
    gitLib = component 'git.ts (mergeMain, prepareGitWorkspaceFromBranch)'
    githubLib = component 'github.ts (findOpenPrForIssue)'
    claudeCli = component 'runClaude()'

    routes -> job 'ジョブを起動'
    job -> githubLib '対象issueのPRを検索'
    job -> gitLib 'ブランチをclone・mainをmerge'
    job -> prompt 'コンフリクトファイルごとにプロンプト構築'
    prompt -> claudeCli 'コンフリクト解決を依頼'
  }

  userscript = system 'userscript' {
    panel = component 'ui/panel.ts (コンフリクト解決ボタン)'
    gmClient = component 'gm-client.ts (resolveConflicts)'

    panel -> gmClient 'ボタン押下'
  }

  github = system 'GitHub' {
    description 'issue・PR・リポジトリのホスティング先'
  }

  maintainer -> panel 'コンフリクト中のPRでボタンを押す'
  gmClient -> webhook.routes 'POST /api/jobs/resolve-conflicts'
  webhook.githubLib -> github 'PR検索 (GitHub API)'
  webhook.gitLib -> github 'clone / fetch / push'
  webhook.claudeCli -> webhook.gitLib '解決済みファイルを書き込み'
}

views {
  view index {
    title '全体像'
    include *
  }

  view of webhook {
    title 'webhook 内部構成'
    include *
  }

  dynamic view resolveFlow {
    title 'コンフリクト解決フロー'
    maintainer -> userscript.panel 'ボタンを押す'
    userscript.panel -> userscript.gmClient '呼び出す'
    userscript.gmClient -> webhook.routes 'POST /resolve-conflicts'
    webhook.routes -> webhook.job 'ジョブ開始'
    webhook.job -> webhook.githubLib 'PRを検索'
    webhook.job -> webhook.gitLib 'main をmerge'
    webhook.job -> webhook.prompt 'コンフリクトを渡す'
    webhook.prompt -> webhook.claudeCli '解決を依頼'
    webhook.job -> github 'push'
  }
}