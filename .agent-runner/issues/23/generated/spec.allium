-- allium: 3

-- issueのタイトル・本文のみを入力として、要件定義/システムアーキテクチャ定義/テスト定義の
-- 3つのsourceコメントをclaude cliに自動ドラフトさせ投稿する draft ジョブの振る舞いを定義する。
-- 既存の convert ジョブ (source→EaC) とは入力の向きが逆 (issue本文→source) であり、
-- 既に存在するsourceコメント (投稿者は問わない) は上書きせず、不足しているkindのみを補う。

enum SourceKind { requirements | architecture | tests }
enum JobKind { convert | draft }

external entity Issue {
    number: Integer
    title: String
    body: String
    source_comments: SourceComment with issue = this
    requirements_comments: source_comments where kind = requirements
    architecture_comments: source_comments where kind = architecture
    tests_comments: source_comments where kind = tests
    has_requirements: requirements_comments.count > 0
    has_architecture: architecture_comments.count > 0
    has_tests: tests_comments.count > 0
    all_sources_present: has_requirements and has_architecture and has_tests
    jobs: Job with issue = this
    is_locked: jobs.any(j => j.status = running)
}

entity Job {
    issue: Issue
    kind: JobKind
    status: pending | running | succeeded | failed
    reads_repository_code: Boolean          -- draftジョブは常にfalse (issue本文のみを入力とする)

    transitions status {
        pending -> running
        running -> succeeded
        running -> failed
        terminal: succeeded
        terminal: failed
    }
}

entity SourceComment {
    issue: Issue
    kind: SourceKind
    generated_by: Job                       -- このコメントを投稿した draft ジョブ
}

rule StartDraft {
    when: RunDraft(issue)
    requires: not issue.is_locked
    ensures:
        Job.created(issue: issue, kind: draft, status: running, reads_repository_code: false)
}

rule SkipDraftWhenAllSourcesExist {
    when: job: Job.status transitions_to running
    requires:
        job.kind = draft
        job.issue.all_sources_present = true
    ensures:
        job.status = succeeded
}

rule FillMissingRequirements {
    when: DraftGenerated(job)
    requires:
        job.status = running
        job.kind = draft
        job.issue.has_requirements = false
    ensures:
        SourceComment.created(issue: job.issue, kind: requirements, generated_by: job)
}

rule FillMissingArchitecture {
    when: DraftGenerated(job)
    requires:
        job.status = running
        job.kind = draft
        job.issue.has_architecture = false
    ensures:
        SourceComment.created(issue: job.issue, kind: architecture, generated_by: job)
}

rule FillMissingTests {
    when: DraftGenerated(job)
    requires:
        job.status = running
        job.kind = draft
        job.issue.has_tests = false
    ensures:
        SourceComment.created(issue: job.issue, kind: tests, generated_by: job)
}

rule CompleteDraft {
    when: DraftGenerated(job)
    requires:
        job.status = running
        job.kind = draft
    ensures:
        job.status = succeeded
}

rule FailDraft {
    when: DraftFailed(job)
    requires:
        job.status = running
        job.kind = draft
    ensures:
        job.status = failed
}

invariant AtMostOneSourceCommentPerKind {
    for issue in Issues:
        issue.requirements_comments.count <= 1
        issue.architecture_comments.count <= 1
        issue.tests_comments.count <= 1
}

invariant DraftJobsNeverReadRepositoryCode {
    for job in Jobs where kind = draft:
        job.reads_repository_code = false
}

actor Maintainer {}

surface DraftButton {
    actor: Maintainer
    triggers: RunDraft(issue)
}

open question "type:bug / type:feature 等のissueラベルによって、draftジョブの出力内容 (再現手順重視 or 実現したいこと重視 等) を出し分けるかどうかは未確定"