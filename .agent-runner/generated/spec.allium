-- allium: 3

-- issue詳細ページへの到達経路(直接アクセス/フルリロード/他GitHubページからのTurbo
-- soft-navigation)によらず、agent-runnerパネルが表示・動作することを保証する振る舞いを定義する。

enum PageKind { issue_detail | other }

entity BrowserTab {
    injected: Boolean                        -- userscriptがこのタブに一度でも注入されたか (フルページロード時のみtrueになる)
    current_page: PageKind

    panel_visible: injected and (current_page = issue_detail)  -- derived (agent-runnerパネルの表示状態)
}

actor GithubUser {}

rule InjectOnFullPageLoad {
    when: FullPageLoad(tab, page_kind)
    -- ブラウザが実URLナビゲーション (フルページロード) を行い、そのURLが拡張後の
    -- @match (https://github.com/* 相当) にマッチした場合にのみ発生する外部刺激。
    -- 変更前は match が https://github.com/*/*/issues/* に限定されていたため、
    -- issue詳細ページ以外へのフルロードではこのイベント自体が発生しなかった。
    ensures:
        tab.injected = true
        tab.current_page = page_kind
}

rule SyncOnSoftNavigate {
    when: SoftNavigate(tab, page_kind)
    -- main.ts の setInterval(sync, 300) / MutationObserver / turbo:load リスナによる同期。
    -- userscriptが既にこのタブに注入されている場合のみ発火しうる (未注入のタブでは
    -- リスナ自体が存在しないため)。
    requires: tab.injected = true
    ensures:
        tab.current_page = page_kind
}

invariant PanelHiddenOutsideIssueDetail {
    for tab in BrowserTabs where current_page = other:
        tab.panel_visible = false
}

invariant PanelVisibleRequiresInjection {
    for tab in BrowserTabs where panel_visible = true:
        tab.injected = true
}

surface AgentRunnerPanel {
    actor: GithubUser
    visible_when: tab.panel_visible = true
}