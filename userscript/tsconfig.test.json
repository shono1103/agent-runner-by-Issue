{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // テストは node で走らせるが、テスト対象のモジュール (location.ts / ui/*.ts) が
    // DOM グローバルを使うため、tsconfig.json と同じ lib を持たせる必要がある。
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.test.ts"]
}
